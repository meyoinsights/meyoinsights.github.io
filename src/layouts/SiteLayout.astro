---
import '../styles/global.css';
const {title = 'Meyo Insights', description = 'A public research journal exploring businesses, industries, markets and the ideas that help us understand them.' , canonicalPath = Astro.url.pathname, archived = false, articleSchema = null} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {archived && <meta name="robots" content="noindex,follow" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={articleSchema ? "article" : "website"} />
    {articleSchema && !archived && <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g, "\\u003c")} />}
    <meta name="theme-color" content="#173d35" />
    <meta property="og:site_name" content="Meyo Insights" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <title>{title} | Meyo Insights</title>
    <!-- No third-party analytics tag loads before explicit acceptance. -->
    <script is:inline defer src="/analytics-consent.js"></script>
    <script is:inline defer src="/publication-downloads.js"></script>
  </head>
  <body>
    <header class="site-header wrap">
      <a class="brand" href="/">MEYO <span>/</span> INSIGHTS</a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/blog/">Research</a>
        <a href="/process/">Our Process</a>
        <a href="/about/">About</a>
        <a class="nav-social" href="https://x.com/meyo_insights" target="_blank" rel="noopener noreferrer" aria-label="Follow Meyo Insights on X">Follow on X ↗</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer wrap">
      <div><strong>Meyo Insights</strong><p>The pursuit of better investment judgment.</p><p><a class="footer-follow" href="https://x.com/meyo_insights" target="_blank" rel="noopener noreferrer">Follow @meyo_insights on X ↗</a></p></div>
      <div class="footer-privacy">
        <p>Independent research journal</p>
        <a href="/privacy/">Privacy</a>
        <button id="analytics-preferences" class="footer-preferences" type="button">Analytics settings</button>
      </div>
    </footer>
    <aside class="analytics-consent" id="analytics-consent" role="region" aria-label="Optional website analytics" hidden>
      <p>May we use optional analytics to understand which research pages are useful? Google Tag Manager loads only if you accept. <a href="/privacy/">Privacy details</a>.</p>
      <div class="analytics-actions">
        <button id="analytics-accept" type="button">Accept analytics</button>
        <button id="analytics-decline" type="button">Decline</button>
      </div>
    </aside>
  </body>
</html>
