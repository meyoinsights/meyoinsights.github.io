---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="The pursuit of better investment judgment">
  <section class="hero wrap">
    <p class="eyebrow">Independent investment research · Kenya and beyond</p>
    <h1>The pursuit of <em>better investment judgment.</em></h1>
    <p class="lead">A public research journal exploring businesses, industries, markets and the ideas that help us understand them.</p>
    <a class="button" href="/blog/">Read the research</a>
  </section>
  <section class="section wrap">
    <p class="eyebrow">Our approach</p>
    <h2>Understand the business first.</h2>
    <p>Good investment decisions require good questions, careful reading and a willingness to change your mind.</p>
    <div class="topics">
      <div class="topic"><h3>Companies</h3><p>How businesses make money, what the financial statements reveal, and how price compares with value.</p></div>
      <div class="topic"><h3>Industries</h3><p>Market structure, economics, competitors and forces shaping long-term returns.</p></div>
      <div class="topic"><h3>Judgment</h3><p>Investment ideas, mistakes and lessons we can carry into the next decision.</p></div>
    </div>
  </section>
</SiteLayout>
